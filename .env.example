# =============================================================================
# stock-monitoring 환경변수 예시 / Environment variable example
#
# 모든 변수는 선택(optional)이며 코드에 기본값이 있다 — backend/app/core/config.py 참조.
# All variables are optional and have code defaults — see backend/app/core/config.py.
#
# 프로덕션에서는 CDK(infra/)가 CACHE_TABLE / BEDROCK_REGION 을 ECS 태스크에 주입한다.
# In production the CDK stack (infra/) injects CACHE_TABLE / BEDROCK_REGION into the ECS task.
#
# 사용법 / Usage: cp .env.example .env  — 실값·시크릿은 절대 커밋하지 않는다.
#                                        Never commit real values or secrets.
# 참고: 앱은 dotenv 로더를 쓰지 않고 OS 환경변수만 읽는다. 로컬에서는 셸에서 export 하거나
#       `env $(grep -v '^#' .env | xargs) make run` 형태로 주입한다.
# Note: the app reads plain OS environment variables (no dotenv loader). Locally, export them
#       in your shell or inject via `env $(grep -v '^#' .env | xargs) make run`.
# =============================================================================

# --- 캐시 / Cache (backend/app/core/config.py) --------------------------------
# DynamoDB L2 캐시 테이블 이름 / DynamoDB L2 cache table name
# CACHE_TABLE=stock-monitoring-cache

# --- Bedrock AI (backend/app/core/config.py) ----------------------------------
# 크로스리전 추론 프로필 ID — ap-northeast-2 에는 `global.` 프리픽스만 유효하다.
# Cross-region inference profile id — only the `global.` prefix is valid in ap-northeast-2.
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Bedrock 호출 리전 / Region used for Bedrock calls
# BEDROCK_REGION=ap-northeast-2

# --- AWS SDK (backend/app/cache/dynamo.py) ------------------------------------
# DynamoDB 리전 — 미설정 시 코드 기본 리전 사용 / DynamoDB region — falls back to the code default
# AWS_REGION=ap-northeast-2

# --- 정적 서빙 / Static serving (backend/app/main.py) --------------------------
# SPA 빌드 디렉터리 오버라이드 — 기본값 backend/static (make build 산출물)
# Override for the SPA build directory — defaults to backend/static (output of `make build`)
# STATIC_DIR=
